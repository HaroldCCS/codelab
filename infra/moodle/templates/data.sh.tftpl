#!/bin/bash
# ============================================================
#  Nodo de datos de Moodle: MariaDB en Docker (sin RDS).
#  Secretos en base64 -> variables de bash entrecomilladas.
# ============================================================
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive

DB_NAME="$(printf '%s' '${db_name_b64}' | base64 -d)"
DB_USER="$(printf '%s' '${db_user_b64}' | base64 -d)"
DB_PASS="$(printf '%s' '${db_pass_b64}' | base64 -d)"
DB_ROOT_PASS="$(printf '%s' '${db_root_pass_b64}' | base64 -d)"

apt-get update -y
apt-get install -y docker.io
systemctl enable --now docker

mkdir -p /data/mysql

docker rm -f moodle-db 2>/dev/null || true
docker run -d --name moodle-db --restart always \
  -e MARIADB_DATABASE="$DB_NAME" \
  -e MARIADB_USER="$DB_USER" \
  -e MARIADB_PASSWORD="$DB_PASS" \
  -e MARIADB_ROOT_PASSWORD="$DB_ROOT_PASS" \
  -p 3306:3306 \
  -v /data/mysql:/var/lib/mysql \
  "${mariadb_image}" \
  --character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci \
  --innodb_file_per_table=1 --wait_timeout=28800 \
  --max_connections=300

docker ps --format '{{.Names}}' | grep -q moodle-db
echo "codelab: nodo MariaDB listo"
