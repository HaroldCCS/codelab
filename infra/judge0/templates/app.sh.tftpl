#!/bin/bash
# ============================================================
#  Nodo Judge0 (server + workers).
#
#  Judge0 1.13.x necesita cgroup v1 para 'isolate' (el sandbox).
#  Ubuntu 22.04 arranca en cgroup v2, asi que en el PRIMER
#  arranque activamos cgroup v1 via GRUB y reiniciamos. Tras el
#  reinicio, el servicio systemd 'judge0' levanta los contenedores
#  (user_data NO se vuelve a ejecutar: cloud-init solo lo corre
#  una vez, por eso la logica va en un servicio aparte).
# ============================================================
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y docker.io netcat-openbsd curl
systemctl enable docker

mkdir -p /opt/judge0

# ------------------------------------------------------------------
#  start.sh — idempotente; lo ejecuta systemd en CADA arranque.
#  Heredoc ENTRECOMILLADO ('START'): bash escribe el contenido tal
#  cual. Los marcadores de Terraform ya fueron sustituidos antes.
# ------------------------------------------------------------------
cat >/opt/judge0/start.sh <<'START'
#!/bin/bash
set -euxo pipefail

DATA_IP='${data_ip}'
PG_DB="$(printf '%s' '${pg_db_b64}' | base64 -d)"
PG_USER="$(printf '%s' '${pg_user_b64}' | base64 -d)"
PG_PASS="$(printf '%s' '${pg_pass_b64}' | base64 -d)"
REDIS_PASS="$(printf '%s' '${redis_pass_b64}' | base64 -d)"
AUTH_TOKEN="$(printf '%s' '${auth_token_b64}' | base64 -d)"

# --- Esperar a que el nodo de datos este realmente escuchando ---
# Sin esto, judge0-server intenta migrar contra una BD que aun no
# existe (el nodo de datos todavia esta instalando Docker) y entra
# en crash-loop con backoff largo.
for i in $(seq 1 120); do
  if nc -z -w 3 "$DATA_IP" 5432 && nc -z -w 3 "$DATA_IP" 6379; then
    echo "codelab: Postgres y Redis accesibles en $DATA_IP"
    break
  fi
  echo "codelab: esperando nodo de datos ($i/120)..."
  sleep 10
done
nc -z -w 3 "$DATA_IP" 5432 || { echo "codelab: ERROR Postgres inaccesible"; exit 1; }
nc -z -w 3 "$DATA_IP" 6379 || { echo "codelab: ERROR Redis inaccesible"; exit 1; }

# --- judge0.conf: parte fija por heredoc citado, secretos por printf ---
# WALL_TIME_LIMIT=45: el formulario del docente ofrece hasta 30 s; con 25
# el motor mataba la ejecucion antes (SEC-07). MAX_MEMORY_LIMIT=524288 KB
# son 512 MiB de verdad: con 512000 se rechazaba la opcion 512 MB (SEC-06).
# Estos valores deben coincidir con judge0/judge0.conf.example del overlay local.
cat >/opt/judge0/judge0.conf <<'CONF'
REDIS_PORT=6379
POSTGRES_PORT=5432
ENABLE_WAIT_RESULT=true
ENABLE_COMPILER_OPTIONS=true
ALLOW_ENABLE_NETWORK=false
ENABLE_NETWORK=false
COUNT=${worker_count}
MAX_CPU_TIME_LIMIT=120
CPU_TIME_LIMIT=15
MAX_WALL_TIME_LIMIT=140
WALL_TIME_LIMIT=45
MAX_MEMORY_LIMIT=524288
MEMORY_LIMIT=262144
MAX_MAX_FILE_SIZE=10240
MAX_FILE_SIZE=4096
MAX_MAX_PROCESSES_AND_OR_THREADS=120
MAX_PROCESSES_AND_OR_THREADS=60
MAX_QUEUE_SIZE=100
CONF

{
  printf 'REDIS_HOST=%s\n'         "$DATA_IP"
  printf 'REDIS_PASSWORD=%s\n'     "$REDIS_PASS"
  printf 'POSTGRES_HOST=%s\n'      "$DATA_IP"
  printf 'POSTGRES_DB=%s\n'        "$PG_DB"
  printf 'POSTGRES_USER=%s\n'      "$PG_USER"
  printf 'POSTGRES_PASSWORD=%s\n'  "$PG_PASS"
} >>/opt/judge0/judge0.conf

# Token de autenticacion: sin el, cualquiera en internet podria
# ejecutar codigo en este servidor. Moodle lo envia en X-Auth-Token.
if [ -n "$AUTH_TOKEN" ]; then
  printf 'AUTHN_TOKEN=%s\n' "$AUTH_TOKEN" >>/opt/judge0/judge0.conf
fi
chmod 600 /opt/judge0/judge0.conf
# Los contenedores de Judge0 corren como uid 1000 (usuario "judge0"): con el
# archivo en root:root 600 no podian leerlo, Rails caia a sus valores por
# defecto (Postgres en localhost) y el servidor entraba en bucle con
# "Connection refused" (comprobado en AWS el 2026-10-30). Se mantiene 600 y
# se le da al uid 1000, que en la AMI de Ubuntu es "ubuntu" (ya tiene sudo).
chown 1000 /opt/judge0/judge0.conf

# --- Descargar la imagen antes de arrancar (con reintentos) ---
for i in $(seq 1 5); do
  docker pull '${judge0_image}' && break
  echo "codelab: reintentando pull de Judge0 ($i/5)"; sleep 15
done

docker rm -f judge0-server judge0-worker 2>/dev/null || true

# Servidor de la API (2358). Su arranque aplica las migraciones.
docker run -d --name judge0-server --restart always --privileged \
  -p 2358:2358 \
  -v /opt/judge0/judge0.conf:/judge0.conf:ro \
  '${judge0_image}'

# Worker: ejecuta el codigo del estudiante dentro del sandbox aislado.
docker run -d --name judge0-worker --restart always --privileged \
  -v /opt/judge0/judge0.conf:/judge0.conf:ro \
  '${judge0_image}' ./scripts/workers

echo "codelab: Judge0 arrancado"
START
chmod 700 /opt/judge0/start.sh

# ------------------------------------------------------------------
#  Servicio systemd
# ------------------------------------------------------------------
cat >/etc/systemd/system/judge0.service <<'UNIT'
[Unit]
Description=Judge0 (server + workers)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/judge0/start.sh
TimeoutStartSec=1800
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable judge0.service

# ------------------------------------------------------------------
#  cgroup v1 + reboot (solo la primera vez). Si el flag YA estaba
#  puesto no reiniciamos, pero entonces hay que arrancar el servicio
#  a mano: si no, nadie levantaria Judge0 en este arranque.
# ------------------------------------------------------------------
#
#  OJO: en las imagenes cloud de Ubuntu, /etc/default/grub.d/50-cloudimg-settings.cfg
#  vuelve a definir GRUB_CMDLINE_LINUX_DEFAULT y pisa lo que se escriba en
#  /etc/default/grub. Editar ese archivo (como se hacia antes) dejaba el
#  kernel en cgroup v2 tras el reinicio y el sandbox fallaba con
#  "Internal Error" (comprobado en AWS el 2026-10-30: /proc/cmdline sin el
#  flag). Un 99-*.cfg se lee despues del 50-* y le anade el flag.
#  Se mira /proc/cmdline, no el archivo: es lo que de verdad arranco.
# ------------------------------------------------------------------
if ! grep -q "systemd.unified_cgroup_hierarchy=0" /proc/cmdline; then
  echo 'GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT systemd.unified_cgroup_hierarchy=0"' \
    > /etc/default/grub.d/99-codelab-cgroupv1.cfg
  update-grub
  echo "codelab: cgroup v1 activado, reiniciando"
  reboot
else
  systemctl start judge0.service
fi
