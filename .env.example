# ============================================================
#  Copia este archivo a ".env" y rellena los valores.
#      cp .env.example .env
#  Docker Compose lo lee automáticamente. Ya NO es opcional:
#  las contraseñas no tienen valor por defecto en los
#  docker-compose*.yml a propósito, para que ningún secreto
#  quede escrito en un archivo versionado (SEC-09).
#  .env está en .gitignore: nunca se sube al repositorio.
# ============================================================

# ── Moodle ────────────────────────────────────────────────
MOODLE_PORT=8080
MOODLE_ADMIN_USER=admin
# Credencial del Moodle LOCAL de pruebas. Cámbiala si el
# entorno deja de ser local.
MOODLE_ADMIN_PASS=Admin1234!
MOODLE_ADMIN_EMAIL=admin@codelab.local
MOODLE_SITE_NAME=CodeLab - Editor de Código

# ── Base de datos de Moodle ───────────────────────────────
DB_NAME=moodle
DB_USER=moodle
# Contraseñas del MariaDB local. Los valores de abajo son marcadores:
# ponles lo que quieras (solo se usan dentro de Docker en tu máquina).
DB_PASSWORD=cambia-esta-clave-moodle
DB_ROOT_PASSWORD=cambia-esta-clave-root

# ── Judge0 (solo si usas el overlay docker-compose.judge0.yml) ──
JUDGE0_PORT=2358
JUDGE0_DB_NAME=judge0
JUDGE0_DB_USER=judge0
# Marcadores: cámbialos. `make judge0-conf` los copia a judge0/judge0.conf,
# así que los dos lados quedan siempre sincronizados.
JUDGE0_DB_PASSWORD=cambia-esta-clave-judge0-pg
JUDGE0_REDIS_PASSWORD=cambia-esta-clave-judge0-redis

# Token que el motor exige en la cabecera X-Auth-Token. OBLIGATORIO:
# sin él, cualquiera que alcance el puerto 2358 ejecuta código
# arbitrario en la máquina (SEC-01 / INC-24). Genéralo con:
#     openssl rand -hex 24
# Pégalo aquí, ejecuta `make judge0-conf` y pon el MISMO valor en
# Moodle: Administración del sitio → Plugins → Módulos de actividad
# → CodeLab → «Clave API de Judge0».
JUDGE0_AUTH_TOKEN=
